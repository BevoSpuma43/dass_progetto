    "/api/analisi-piatto": {
      "post": {
        "operationId": "analizzaPiatto",
        "tags": [
          "Analisi"
        ],
        "summary": "Analizza foto e descrizione con Claude Sonnet 5.5",
        "description": "Richiesta nel canale cifrato: servono le intestazioni X-DASS-Scambio e X-DASS-Busta. Il corpo, se presente, è una BustaCifrata; la risposta della risorsa arriva cifrata come BustaCifrata con l'intestazione X-DASS-Cifrato: 1. Gli errori del canale (401, 403, 409, 429 e 400 sulla busta) arrivano in chiaro. Swagger UI non può cifrare le buste: usa il browser o scripts/Verifica-Servizio.ps1. È l'unico punto in cui Payara riceve dati in chiaro, dentro il canale cifrato e solo con il consenso dell'utente: foto e descrizione vengono inoltrate ad Anthropic e non vengono salvate. La bozza viene salvata dal browser dopo averla cifrata.",
        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "BustaCifrata che contiene una RichiestaAnalisi.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BustaCifrata"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Proposta di ingredienti e grammi. Viaggia cifrato: lo schema in chiaro è {proposta: Proposta}.",
            "headers": {
              "X-DASS-Cifrato": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BustaCifrata"
                }
              }
            }
          },
          "400": {
            "description": "Busta assente, illeggibile, scaduta o che descrive un'altra richiesta (BUSTA_ASSENTE, BUSTA_NON_VALIDA, BUSTA_NON_CORRISPONDENTE, BUSTA_SCADUTA, CORPO_NON_VALIDO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "401": {
            "description": "Scambio di chiavi assente o scaduto (SCAMBIO_ASSENTE, SCAMBIO_SCADUTO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "413": {
            "description": "Foto oltre 5 MiB (UPLOAD_GRANDE). Cifrato."
          },
          "503": {
            "description": "Claude non disponibile o chiave non configurata (CHIAVE_ASSENTE, FORNITORE_INDISPONIBILE, RETE). Cifrato."
          }
        }
      }
    },
    "/api/archivio-h2": {
      "get": {
        "operationId": "vistaArchivio",
        "tags": [
          "Verifica della cifratura"
        ],
        "summary": "Mostra i record della tabella DOCUMENTO_CIFRATO",
        "description": "Richiesta nel canale cifrato: servono le intestazioni X-DASS-Scambio e X-DASS-Busta. Il corpo, se presente, è una BustaCifrata; la risposta della risorsa arriva cifrata come BustaCifrata con l'intestazione X-DASS-Cifrato: 1. Gli errori del canale (401, 403, 409, 429 e 400 sulla busta) arrivano in chiaro. Swagger UI non può cifrare le buste: usa il browser o scripts/Verifica-Servizio.ps1. Vista dimostrativa: documenti di tutti i profili con metadati, lunghezza ed estratto del testo cifrato. Serve uno scambio valido di qualunque profilo.",
        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record più recenti. Viaggia cifrato: lo schema in chiaro è VistaH2.",
            "headers": {
              "X-DASS-Cifrato": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BustaCifrata"
                }
              }
            }
          },
          "400": {
            "description": "Busta assente, illeggibile, scaduta o che descrive un'altra richiesta (BUSTA_ASSENTE, BUSTA_NON_VALIDA, BUSTA_NON_CORRISPONDENTE, BUSTA_SCADUTA, CORPO_NON_VALIDO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "401": {
            "description": "Scambio di chiavi assente o scaduto (SCAMBIO_ASSENTE, SCAMBIO_SCADUTO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          }
        }
      }
    },
    "/api/archivio-h2/{profilo}/{id}": {
      "get": {
        "operationId": "leggiRecordH2",
        "tags": [
          "Verifica della cifratura"
        ],
        "summary": "Legge un record di H2 completo",
        "description": "Richiesta nel canale cifrato: servono le intestazioni X-DASS-Scambio e X-DASS-Busta. Il corpo, se presente, è una BustaCifrata; la risposta della risorsa arriva cifrata come BustaCifrata con l'intestazione X-DASS-Cifrato: 1. Gli errori del canale (401, 403, 409, 429 e 400 sulla busta) arrivano in chiaro. Swagger UI non può cifrare le buste: usa il browser o scripts/Verifica-Servizio.ps1. Restituisce il testo cifrato completo di un documento di qualunque profilo, per provare a decifrarlo con la chiave del profilo attivo.",
        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "parameters": [
          {
            "name": "profilo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "utente1"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "example": "p-934ca026-a0a6-4000-bc91-c7abe5d3548f"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Il record con il profilo proprietario. Viaggia cifrato: lo schema in chiaro è DocumentoGrezzo.",
            "headers": {
              "X-DASS-Cifrato": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BustaCifrata"
                }
              }
            }
          },
          "400": {
            "description": "Busta assente, illeggibile, scaduta o che descrive un'altra richiesta (BUSTA_ASSENTE, BUSTA_NON_VALIDA, BUSTA_NON_CORRISPONDENTE, BUSTA_SCADUTA, CORPO_NON_VALIDO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "401": {
            "description": "Scambio di chiavi assente o scaduto (SCAMBIO_ASSENTE, SCAMBIO_SCADUTO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "scambio": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DASS-Scambio",
        "description": "Identificativo dello scambio di chiavi dell'azione."
      },
      "busta": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DASS-Busta",
        "description": "base64url(iv).base64url(testo cifrato) di un DescrittoreBusta."
      }
    },
    "schemas": {
      "Errore": {
        "type": "object",
        "required": [
          "codice",
          "messaggio"
        ],
        "properties": {
          "codice": {
            "type": "string",
            "example": "SCAMBIO_SCADUTO"
          },
          "messaggio": {
            "type": "string"
          }
        }
      },
      "Macronutrienti": {
        "type": "object",
        "required": [
          "carboidratiG",
          "proteineG",
          "grassiG",
          "kcal"
        ],
        "properties": {
          "carboidratiG": {
            "type": "number"
          },
          "proteineG": {
            "type": "number"
          },
          "grassiG": {
            "type": "number"
          },
          "kcal": {
            "type": "number"
          }
        }
      },
      "VoceCatalogo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "pasta-cotta-v1"
          },
          "nome": {
            "type": "string",
            "example": "Pasta di semola"
          },
          "preparazione": {
            "type": "string",
            "enum": [
              "crudo",
              "cotto",
              "non_noto"
            ]
          },
          "unita": {
            "type": "string",
            "example": "g"
          },
          "versione": {
            "type": "string"
          },
          "fonte": {
            "type": "string"
          },
          "indiceGlicemico": {
            "type": "string"
          },
          "per100g": {
            "$ref": "#/components/schemas/Macronutrienti"
          }
        }
      },
      "Profilo": {
        "type": "object",
        "required": [
          "id",
          "nome",
          "documenti"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "utente1"
          },
          "nome": {
            "type": "string",
            "example": "Utente 1"
          },
          "documenti": {
            "type": "integer",
            "description": "Numero di documenti cifrati del profilo."
          }
        }
      },
      "AperturaScambio": {
        "type": "object",
        "required": [
          "profiloId",
          "azione",
          "chiavePubblica"
        ],
        "properties": {
          "profiloId": {
            "type": "string",
            "example": "utente1"
          },
          "azione": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$",
            "example": "apertura-storico",
            "description": "Nome dell'azione del diario: entra nella derivazione della chiave."
          },
          "chiavePubblica": {
            "type": "string",
            "format": "byte",
            "description": "Chiave pubblica ECDH P-256 del browser, punto non compresso di 65 byte."
          }
        }
      },
      "Scambio": {
        "type": "object",
        "required": [
          "scambioId",
          "chiavePubblica",
          "sale",
          "scadeAlle",
          "algoritmo",
          "improntaBrowser",
          "improntaServer"
        ],
        "properties": {
          "scambioId": {
            "type": "string",
            "format": "uuid"
          },
          "chiavePubblica": {
            "type": "string",
            "format": "byte",
            "description": "Chiave pubblica effimera di Payara, 65 byte."
          },
          "sale": {
            "type": "string",
            "format": "byte",
            "description": "Sale HKDF di 32 byte."
          },
          "scadeAlle": {
            "type": "string",
            "format": "date-time"
          },
          "algoritmo": {
            "type": "string",
            "example": "ECDH P-256 · HKDF-SHA-256 · AES-GCM 256"
          },
          "improntaBrowser": {
            "type": "string",
            "example": "81b0 3b11 a2d5 8261",
            "description": "Primi 64 bit dello SHA-256 della chiave pubblica ricevuta dal browser."
          },
          "improntaServer": {
            "type": "string",
            "example": "2fd0 4e4e 66f5 9756"
          }
        }
      },
      "DescrittoreBusta": {
        "type": "object",
        "description": "Contenuto in chiaro di X-DASS-Busta, cifrato con AAD \"DASS|richiesta|scambioId\".",
        "required": [
          "metodo",
          "percorso",
          "nonce",
          "istante"
        ],
        "properties": {
          "metodo": {
            "type": "string",
            "example": "GET"
          },
          "percorso": {
            "type": "string",
            "example": "/dass/api/profili/utente1/documenti?tipo=pasto"
          },
          "nonce": {
            "type": "string",
            "format": "uuid"
          },
          "istante": {
            "type": "integer",
            "description": "Millisecondi dall'epoca Unix; tolleranza di 2 minuti."
          }
        }
      },
      "BustaCifrata": {
        "type": "object",
        "required": [
          "iv",
          "dati"
        ],
        "description": "AES-GCM con la chiave dello scambio. AAD del corpo: \"DASS|corpo|scambioId|nonce\"; della risposta: \"DASS|risposta|scambioId|nonce\".",
        "properties": {
          "iv": {
            "type": "string",
            "format": "byte",
            "description": "IV di 12 byte."
          },
          "dati": {
            "type": "string",
            "format": "byte",
            "description": "Testo cifrato con tag di 16 byte."
          }
        }
      },
      "ScritturaDocumento": {
        "type": "object",
        "required": [
          "tipo",
          "revisione",
          "iv",
          "dati"
        ],
        "description": "Documento cifrato nel browser con la chiave del diario. AAD: \"DASS|diario|v1|profilo|tipo|id\".",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "impostazioni",
              "bozza",
              "foto",
              "miniatura",
              "pasto"
            ]
          },
          "revisione": {
            "type": "integer",
            "minimum": 0
          },
          "iv": {
            "type": "string",
            "format": "byte",
            "description": "IV di 12 byte."
          },
          "dati": {
            "type": "string",
            "format": "byte",
            "description": "Testo cifrato, da 16 byte a 8 MiB."
          }
        }
      },
      "DocumentoCifrato": {
        "type": "object",
        "required": [
          "id",
          "tipo",
          "revisione",
          "iv",
          "dati",
          "aggiornatoAlle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "impostazioni",
              "bozza",
              "foto",
              "miniatura",
              "pasto"
            ]
          },
          "revisione": {
            "type": "integer"
          },
          "iv": {
            "type": "string",
            "format": "byte",
            "description": "IV di 12 byte."
          },
          "dati": {
            "type": "string",
            "format": "byte",
            "description": "Testo cifrato."
          },
          "aggiornatoAlle": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentoGrezzo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DocumentoCifrato"
          },
          {
            "type": "object",
            "required": [
              "profilo"
            ],
            "properties": {
              "profilo": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Ricevuta": {
        "type": "object",
        "required": [
          "id",
          "tipo",
          "revisione",
          "aggiornatoAlle"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "revisione": {
            "type": "integer"
          },
          "aggiornatoAlle": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Eliminazione": {
        "type": "object",
        "required": [
          "eliminato"
        ],
        "properties": {
          "eliminato": {
            "type": "boolean"
          }
        }
      },
      "RigaH2": {
        "type": "object",
        "properties": {
          "profilo": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "revisione": {
            "type": "integer"
          },
          "iv": {
            "type": "string",
            "format": "byte",
            "description": "IV di 12 byte."
          },
          "byte": {
            "type": "integer"
          },
          "estratto": {
            "type": "string",
            "format": "byte",
            "description": "Primi 48 byte del testo cifrato."
          },
          "aggiornatoAlle": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VistaH2": {
        "type": "object",
        "properties": {
          "tabella": {
            "type": "string",
            "example": "DOCUMENTO_CIFRATO"
          },
          "documenti": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RigaH2"
            }
          }
        }
      },
      "RichiestaAnalisi": {
        "type": "object",
        "required": [
          "consenso",
          "foto"
        ],
        "properties": {
          "consenso": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Consenso esplicito all'invio di foto e descrizione a Payara e ad Anthropic."
          },
          "foto": {
            "type": "string",
            "format": "byte",
            "description": "JPEG o PNG fino a 5 MiB."
          },
          "caption": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "IngredienteProposto": {
        "type": "object",
        "required": [
          "nome",
          "stato",
          "origineQuantita"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "stato": {
            "type": "string",
            "enum": [
              "crudo",
              "cotto",
              "non_noto"
            ]
          },
          "quantitaG": {
            "type": "number",
            "nullable": true
          },
          "origineQuantita": {
            "type": "string",
            "enum": [
              "caption",
              "stimata",
              "ricetta",
              "da_chiarire"
            ]
          },
          "motivazione": {
            "type": "string"
          },
          "fonteUrl": {
            "type": "string",
            "format": "uri"
          },
          "fonteTitolo": {
            "type": "string"
          }
        }
      },
      "Proposta": {
        "type": "object",
        "required": [
          "modello",
          "ingredienti",
          "dubbi"
        ],
        "properties": {
          "modello": {
            "type": "string",
            "example": "claude-sonnet-5-5"
          },
          "statoAnalisi": {
            "type": "string",
            "example": "da_confermare"
          },
          "ingredienti": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngredienteProposto"
            }
          },
          "dubbi": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ContenutoImpostazioni": {
        "type": "object",
        "description": "Contenuto in chiaro del documento impostazioni-<profilo>: esiste solo nel browser.",
        "properties": {
          "icr": {
            "type": "number",
            "description": "Grammi di carboidrati coperti da 1 unità (1-150)."
          },
          "isf": {
            "type": "number",
            "description": "mg/dL abbassati da 1 unità (5-500)."
          },
          "glicemiaObiettivo": {
            "type": "number",
            "default": 120
          },
          "aggiornateAlle": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CalcoloBolo": {
        "type": "object",
        "description": "bolo = carboidrati / ICR + (glicemia attuale − glicemia obiettivo) / ISF, calcolato nel browser. Didattico: non è una prescrizione.",
        "properties": {
          "carboidratiG": {
            "type": "number"
          },
          "icr": {
            "type": "number"
          },
          "isf": {
            "type": "number"
          },
          "glicemiaAttuale": {
            "type": "number"
          },
          "glicemiaObiettivo": {
            "type": "number"
          },
          "quotaPasto": {
            "type": "number"
          },
          "correzione": {
            "type": "number"
          },
          "totale": {
            "type": "number"
          },
          "boloCalcolato": {
            "type": "number",
            "description": "Totale non negativo; 0 con glicemia sotto 70 mg/dL."
          },
          "avvisi": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ContenutoPasto": {
        "type": "object",
        "description": "Contenuto in chiaro del documento p-<uuid>: esiste solo nel browser.",
        "properties": {
          "pastoId": {
            "type": "string"
          },
          "nomePiatto": {
            "type": "string"
          },
          "consumatoAlle": {
            "type": "string",
            "format": "date-time"
          },
          "ingredienti": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "totali": {
            "$ref": "#/components/schemas/Macronutrienti"
          },
          "bolo": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CalcoloBolo"
              }
            ],
            "nullable": true
          },
          "fotoId": {
            "type": "string"
          },
          "miniaturaId": {
            "type": "string"
          }
        }
      }
    }
  }
}
