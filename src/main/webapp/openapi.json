        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "parameters": [
          {
            "name": "profilo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "utente1"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
