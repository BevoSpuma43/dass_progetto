{
  "openapi": "3.0.3",
  "info": {
    "title": "API REST DASS",
    "version": "0.2.0",
    "description": "Diario alimentare con analisi della foto (Claude Sonnet 5.5), calcolo del bolo nel browser e archivio cifrato. I documenti del diario sono cifrati nel browser con una chiave AES-GCM per profilo, non esportabile; ogni azione che legge o scrive H2 apre uno scambio di chiavi ECDH e usa il canale cifrato che ne deriva. Payara conserva solo testo cifrato e metadati minimi."
  },
  "servers": [
    {
      "url": "/dass",
      "description": "Applicazione DASS"
    }
  ],
  "tags": [
    {
      "name": "Servizio"
    },
    {
      "name": "Profili"
    },
    {
      "name": "Scambio di chiavi"
    },
    {
      "name": "Diario cifrato"
    },
    {
      "name": "Analisi"
    },
    {
      "name": "Verifica della cifratura"
    }
  ],
  "paths": {
    "/api/stato": {
      "get": {
        "operationId": "leggiStato",
        "tags": [
          "Servizio"
        ],
        "summary": "Verifica lo stato di DASS",
        "responses": {
          "200": {
            "description": "Il backend risponde.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stato"
                  ],
                  "properties": {
                    "stato": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogo": {
      "get": {
        "operationId": "cercaCatalogo",
        "tags": [
          "Servizio"
        ],
        "summary": "Consulta le schede del catalogo nutrizionale",
        "description": "Catalogo pubblico, in chiaro: le schede non sono dati personali.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Filtro facoltativo per parola o preparazione.",
            "schema": {
              "type": "string",
              "example": "farina 0"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schede e valori per 100 g.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VoceCatalogo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/profili": {
      "get": {
        "operationId": "elencaProfili",
        "tags": [
          "Profili"
        ],
        "summary": "Elenca i profili",
        "description": "Elenco pubblico: solo identificativi, nomi e numero di documenti cifrati. All'avvio esistono utente1 e utente2, con diario vuoto.",
        "responses": {
          "200": {
            "description": "Profili disponibili.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Profilo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/scambi": {
      "post": {
        "operationId": "apriScambio",
        "tags": [
          "Scambio di chiavi"
        ],
        "summary": "Apre lo scambio di chiavi ECDH di un'azione",
        "description": "Il browser invia la chiave pubblica effimera P-256 (punto non compresso, 65 byte) e riceve quella di Payara con un sale di 32 byte. Entrambi calcolano il segreto ECDH e derivano con HKDF-SHA-256 (info \"DASS-scambio-v1|scambioId|profiloId|azione\") la chiave AES-GCM 256 del canale. Lo scambio vale 5 minuti, per un solo profilo e una sola azione, al massimo 500 richieste.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AperturaScambio"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scambio aperto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scambio"
                }
              }
            }
          },
          "400": {
            "description": "Azione o chiave pubblica non valida (SCAMBIO_NON_VALIDO, CHIAVE_PUBBLICA_NON_VALIDA).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "404": {
            "description": "Profilo inesistente (PROFILO_ASSENTE).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          }
        }
      }
    },
    "/api/profili/{profilo}/documenti": {
      "get": {
        "operationId": "elencaDocumenti",
        "tags": [
          "Diario cifrato"
        ],
        "summary": "Elenca i documenti cifrati di un tipo",
        "description": "Richiesta nel canale cifrato: servono le intestazioni X-DASS-Scambio e X-DASS-Busta. Il corpo, se presente, è una BustaCifrata; la risposta della risorsa arriva cifrata come BustaCifrata con l'intestazione X-DASS-Cifrato: 1. Gli errori del canale (401, 403, 409, 429 e 400 sulla busta) arrivano in chiaro. Swagger UI non può cifrare le buste: usa il browser o scripts/Verifica-Servizio.ps1. Lo scambio deve appartenere al profilo del percorso.",
        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "parameters": [
          {
            "name": "profilo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "utente1"
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "impostazioni",
                "bozza",
                "foto",
                "miniatura",
                "pasto"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documenti del tipo, dal più recente. Viaggia cifrato: lo schema in chiaro è un array di DocumentoCifrato.",
            "headers": {
              "X-DASS-Cifrato": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BustaCifrata"
                }
              }
            }
          },
          "400": {
            "description": "Busta assente, illeggibile, scaduta o che descrive un'altra richiesta (BUSTA_ASSENTE, BUSTA_NON_VALIDA, BUSTA_NON_CORRISPONDENTE, BUSTA_SCADUTA, CORPO_NON_VALIDO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "401": {
            "description": "Scambio di chiavi assente o scaduto (SCAMBIO_ASSENTE, SCAMBIO_SCADUTO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "403": {
            "description": "Scambio di un altro profilo (SCAMBIO_DI_ALTRO_PROFILO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "404": {
            "description": "Profilo inesistente (PROFILO_ASSENTE). Cifrato."
          }
        }
      }
    },
    "/api/profili/{profilo}/documenti/{id}": {
      "get": {
        "operationId": "leggiDocumento",
        "tags": [
          "Diario cifrato"
