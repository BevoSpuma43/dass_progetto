              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ricevuta del salvataggio. Viaggia cifrato: lo schema in chiaro è Ricevuta.",
            "headers": {
              "X-DASS-Cifrato": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BustaCifrata"
                }
              }
            }
          },
          "400": {
            "description": "Busta assente, illeggibile, scaduta o che descrive un'altra richiesta (BUSTA_ASSENTE, BUSTA_NON_VALIDA, BUSTA_NON_CORRISPONDENTE, BUSTA_SCADUTA, CORPO_NON_VALIDO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "401": {
            "description": "Scambio di chiavi assente o scaduto (SCAMBIO_ASSENTE, SCAMBIO_SCADUTO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "403": {
            "description": "Scambio di un altro profilo (SCAMBIO_DI_ALTRO_PROFILO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "413": {
            "description": "Testo cifrato oltre 8 MiB (DOCUMENTO_GRANDE). Cifrato."
          }
        }
      },
      "delete": {
        "operationId": "eliminaDocumento",
        "tags": [
          "Diario cifrato"
        ],
