            }
          },
          "409": {
            "description": "Nonce già usato: la richiesta è una ripetizione (BUSTA_RIPETUTA). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "429": {
            "description": "Troppe richieste per lo stesso scambio (SCAMBIO_ESAURITO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "403": {
            "description": "Scambio di un altro profilo (SCAMBIO_DI_ALTRO_PROFILO). In chiaro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Errore"
                }
              }
            }
          },
          "404": {
            "description": "Documento inesistente o di un altro profilo (DOCUMENTO_ASSENTE). Cifrato."
          }
        }
      },
      "put": {
        "operationId": "salvaDocumento",
        "tags": [
          "Diario cifrato"
        ],
        "summary": "Crea o sostituisce un documento cifrato",
        "description": "Richiesta nel canale cifrato: servono le intestazioni X-DASS-Scambio e X-DASS-Busta. Il corpo, se presente, è una BustaCifrata; la risposta della risorsa arriva cifrata come BustaCifrata con l'intestazione X-DASS-Cifrato: 1. Gli errori del canale (401, 403, 409, 429 e 400 sulla busta) arrivano in chiaro. Swagger UI non può cifrare le buste: usa il browser o scripts/Verifica-Servizio.ps1. Revisione attesa 0 per creare il documento; altrimenti deve coincidere con quella salvata (REVISIONE_SUPERATA). Gli id sono unici in tutto l'archivio (DOCUMENTO_ESISTENTE).",
        "security": [
          {
            "scambio": [],
            "busta": []
          }
        ],
        "parameters": [
          {
            "name": "profilo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "utente1"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
