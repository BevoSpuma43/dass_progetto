<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
  <persistence-unit name="dass-test" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>it.unisi.dass.persistenza.Profilo</class>
    <class>it.unisi.dass.persistenza.DocumentoCifrato</class>
    <class>it.unisi.dass.persistenza.VoceCatalogo</class>
    <class>it.unisi.dass.persistenza.CaricamentoDemo</class>
    <class>it.unisi.dass.persistenza.Macronutrienti</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
      <property name="eclipselink.ddl-generation.output-mode" value="database"/>
    </properties>
  </persistence-unit>
</persistence>
